---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AiDraftBadge from '../AiDraftBadge.astro';
import MasteryCheck from '../islands/MasteryCheck';
import type { Lang } from '../../config/site';
import { t } from '../../i18n';
import { getQuizItems } from '../../lib/content';
interface Props {
  lang: Lang;
  entry: CollectionEntry<'units'>;
}
const { lang, entry } = Astro.props;
const unit = entry.data;
const { Content } = await render(entry);
const competency = await getEntry('competencies', unit.competency);
const allResources = await getCollection('resources');
const resources = unit.resources
  .map((id) => allResources.find((r) => r.data.id === id)?.data)
  .filter((r) => r !== undefined);
const items = (await getQuizItems(lang)).filter((i) => i.competency === unit.competency);
---

<BaseLayout lang={lang} title={unit.title}>
  <article>
    <p class="text-sm text-slate-700">
      {t(lang, 'unit.competency')}: {competency?.data.title[lang]} · {t(lang, 'unit.level')}: {t(lang, `level.${unit.level}`)} ·
      {unit.minutes}
      {t(lang, 'unit.minutes')}
    </p>
    <h1 class="mt-1 mb-3 text-3xl font-bold">{unit.title}</h1>
    {unit.status === 'ai-draft' && <AiDraftBadge lang={lang} />}
    <section class="mt-6 rounded border border-slate-300 bg-white p-4" aria-labelledby="objectives">
      <h2 id="objectives" class="mb-2 font-semibold">{t(lang, 'unit.objectives')}</h2>
      <ul class="list-disc pl-6">{unit.objectives.map((o) => <li>{o}</li>)}</ul>
    </section>
    <div class="prose-unit mt-6">
      <Content />
    </div>
    <section class="mt-8" aria-labelledby="resources">
      <h2 id="resources" class="mb-3 text-xl font-semibold">{t(lang, 'unit.resources')}</h2>
      <ul class="space-y-3">
        {
          resources.map((r) => (
            <li class="rounded border border-slate-300 bg-white p-3">
              <a href={r.url} class="font-medium text-blue-800 underline" rel="noopener noreferrer">
                {r.title}
              </a>{' '}
              <span class="text-sm text-slate-700">
                ({t(lang, 'unit.linkOnly')}, {r.provider}, {r.language.toUpperCase()}, {r.minutes} {t(lang, 'unit.minutes')}) ·{' '}
                {t(lang, 'unit.license')}: <a class="underline" href={r.licenseUrl}>{r.license}</a>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
    {
      unit.sources.length > 0 && (
        <section class="mt-8" aria-labelledby="sources">
          <h2 id="sources" class="mb-3 text-xl font-semibold">{t(lang, 'unit.attribution')}</h2>
          <ul class="list-disc space-y-1 pl-6 text-sm">
            {unit.sources.map((s) => (
              <li>
                <a class="underline" href={s.url}>{s.title}</a>
                {s.author && <span> — {s.author}</span>}
                {s.license && (
                  <span>
                    {' '}· {s.licenseUrl ? <a class="underline" href={s.licenseUrl}>{s.license}</a> : s.license}
                  </span>
                )}
                {s.changes && <span> · {s.changes}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="mt-10" aria-labelledby="mastery">
      <h2 id="mastery" class="mb-3 text-xl font-semibold">{t(lang, 'mastery.title')}</h2>
      <MasteryCheck client:load lang={lang} unitId={unit.id} competency={unit.competency} level={unit.level} items={items} />
    </section>
  </article>
</BaseLayout>
