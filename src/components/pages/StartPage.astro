---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Onboarding from '../islands/Onboarding';
import type { Lang } from '../../config/site';
import { t } from '../../i18n';
import { getQuizItems, getRoles } from '../../lib/content';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const roles = await getRoles(lang);
const items = await getQuizItems(lang);
---

<BaseLayout lang={lang} title={t(lang, 'start.title')}>
  <h1 class="mb-6 text-3xl font-bold">{t(lang, 'start.title')}</h1>
  <Onboarding client:load lang={lang} roles={roles} items={items} />
</BaseLayout>
